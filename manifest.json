{
  "manifest_version": 3,
  "name": "Job Tracker 求职投递追踪",
  "version": "1.0.0",
  "description": "一键/自动记录投递的公司、职位和 JD，识别 Gmail 里的 OA/面试/拒信并更新状态。数据只保存在本机浏览器。",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "记录这个职位 (Alt+Shift+J)",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "options_page": "dashboard/dashboard.html",
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+J" } }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "*://*.greenhouse.io/*", "*://*.lever.co/*", "*://*.myworkdayjobs.com/*", "*://*.myworkdaysite.com/*",
        "*://*.ashbyhq.com/*", "*://*.icims.com/*", "*://*.jobvite.com/*", "*://*.smartrecruiters.com/*",
        "*://*.workable.com/*", "*://*.bamboohr.com/*", "*://*.breezy.hr/*", "*://*.recruitee.com/*", "*://*.rippling.com/*"
      ],
      "js": ["lib/analyze.js", "content/extractors.js", "content/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.greenhouse.io/*", "*://*.lever.co/*", "*://*.myworkdayjobs.com/*", "*://*.myworkdaysite.com/*",
        "*://*.ashbyhq.com/*", "*://*.icims.com/*", "*://*.jobvite.com/*", "*://*.smartrecruiters.com/*",
        "*://*.workable.com/*", "*://*.bamboohr.com/*", "*://*.breezy.hr/*", "*://*.recruitee.com/*", "*://*.rippling.com/*"
      ],
      "js": ["lib/analyze.js", "content/extractors.js", "content/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content/gmail.js"],
      "run_at": "document_idle"
    }
  ]
}
